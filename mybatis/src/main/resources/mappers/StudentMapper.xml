<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mybatis.mapper.StudentMapper">

  <!-- Get all students -->
  <select id="getAllStudent" resultType="com.mybatis.model.Student">
    SELECT * FROM student;
  </select>

  <!-- Student ResultMap -->
  <resultMap id="studentResultMap" type="com.mybatis.model.Student">
    <id property="studId" column="stud_id"/>
    <result property="name" column="name"/>
    <result property="email" column="email"/>
    <result property="phone" column="phone"/>
    <result property="dob" column="dob"/>
    <result property="bio" column="bio"/>
    <result property="gender" column="gender"/>
  </resultMap>

  <!-- Find student by ID -->
  <select id="findStudentById" parameterType="int" resultMap="studentResultMap">
    SELECT * FROM student WHERE stud_id=#{id}
  </select>

  <!-- Insert new student -->
  <insert id="insertStudent" parameterType="com.mybatis.model.Student" useGeneratedKeys="true" keyProperty="studId">
    INSERT INTO student (stud_id, name, email, phone, dob, bio, addr_id, gender)
    VALUES(#{studId}, #{name}, #{email}, #{phone}, #{dob}, #{bio}, #{address.addrId}, #{gender})
  </insert>

  <!-- Update student -->
  <update id="updateStudent" parameterType="com.mybatis.model.Student">
    UPDATE student 
    SET name=#{name}, email=#{email}, phone=#{phone}, dob=#{dob}, bio=#{bio} 
    WHERE stud_id=#{studId}
  </update>

  <!-- Address ResultMap -->
  <resultMap id="addressResult" type="com.mybatis.model.Address">
    <id property="addrId" column="addr_id"/>
    <result property="street" column="street"/>
    <result property="city" column="city"/>
    <result property="state" column="state"/>
    <result property="zip" column="zip"/>
    <result property="country" column="country"/>
  </resultMap>

  <!-- Student ResultMap with Address association -->
  <resultMap id="studentWithAddressResultMap" type="com.mybatis.model.Student">
    <id property="studId" column="stud_id"/>
    <result property="name" column="name"/>
    <result property="email" column="email"/>
    <result property="phone" column="phone"/>
    <result property="dob" column="dob"/>
    <result property="bio" column="bio"/>
    <association property="address" resultMap="addressResult"/>
  </resultMap>

  <!-- Find student with address -->
  <select id="findStudentWithAddress" parameterType="int" resultMap="studentWithAddressResultMap">
    SELECT stud_id, name, email, phone, dob, bio, street, city, state, zip, country 
    FROM student s 
    JOIN address a ON s.addr_id = a.addr_id 
    WHERE stud_id=#{id}
  </select>

  <!-- Course ResultMap -->
  <resultMap id="courseResult" type="com.mybatis.model.Course">
    <id property="courseId" column="course_id"/>
    <result property="name" column="name"/>
    <result property="description" column="description"/>
    <result property="startDate" column="start_date"/>
    <result property="endDate" column="end_date"/>
  </resultMap>

  <!-- Tutor ResultMap with Course and Address associations -->
  <resultMap id="tutorResult" type="com.mybatis.model.Tutors">
    <id property="tutorId" column="tutor_id"/>
    <result property="name" column="name"/>
    <result property="email" column="email"/>
    <result property="phone" column="phone"/>
    <association property="address" resultMap="addressResult"/>
    <collection property="course" resultMap="courseResult"/>
  </resultMap>

  <!-- Find tutor by ID -->
  <select id="findTutorById" parameterType="int" resultMap="tutorResult">
    SELECT t.tutor_id, t.name AS tutor_name, t.email, t.phone, 
           c.course_id, c.name AS course_name, c.description, c.start_date, c.end_date, 
           a.addr_id, a.city
    FROM tutors t
    LEFT JOIN address a ON t.addr_id = a.addr_id
    LEFT JOIN course c ON t.tutor_id = c.tutor_id
    WHERE t.tutor_id=#{tutorId}
  </select>

  <!-- Dynamic query for searching courses -->
  <select id="searchCourses" parameterType="hashMap" resultMap="courseResult">
    SELECT * FROM course WHERE tutor_id=#{tutorId}
    <if test="courseName != null">
      AND name LIKE #{courseName}
    </if>
    <if test="description != null">
      AND description = #{description}
    </if>
    <if test="startDate != null">
      AND start_date >= #{startDate}
    </if>
  </select>

  <!-- Dynamic query using 'choose' statement -->
  <select id="searchCoursesUsingChoose" parameterType="hashMap" resultMap="courseResult">
    SELECT * FROM course 
    <choose>
      <when test="searchBy == 'Tutor'">
        WHERE tutor_id = #{tutorId}
      </when>
      <when test="searchBy == 'CourseName'">
        WHERE name LIKE #{courseName}
      </when>
      <otherwise>
        WHERE start_date >= NOW()
      </otherwise>
    </choose>
  </select>

  <!-- Dynamic query with 'where' condition -->
  <select id="searchCourseByWhere" parameterType="hashMap" resultMap="courseResult">
    SELECT * FROM course 
    <where>
      <if test="tutorId != null">
        tutor_id = #{tutorId}
      </if>
      <if test="courseName != null">
        AND name LIKE #{courseName}
      </if>
      <if test="startDate != null">
        AND start_date = #{startDate}
      </if>
      <if test="endDate != null">
        AND end_date = #{endDate}
      </if>
    </where>
  </select>

  <!-- Dynamic query with 'trim' condition -->
  <select id="searchCourseByTrim" parameterType="hashMap" resultMap="courseResult">
    SELECT * FROM course 
    <trim prefix="WHERE" prefixOverrides="AND | OR">
      <if test="tutorId != null">
        tutor_id = #{tutorId}
      </if>
      <if test="courseName != null">
        AND name LIKE #{courseName}
      </if>
    </trim>
  </select>

  <!-- Dynamic query with 'foreach' -->
  <select id="searchCoursesByTutors" parameterType="hashMap" resultMap="courseResult">
    SELECT * FROM course
    <if test="tutorIds != null">
      <where>
        <foreach item="tutorId" collection="tutorIds" open="(" separator="," close=")">
          #{tutorId}
        </foreach>
      </where>
    </if>
  </select>
  
  <!--RowBounds for pagination start-->
  <select id="findAllStudents" resultMap="studentResultMap">
  SELECT * FROM student
  </select>
  <!--RowBounds for pagination end-->
</mapper>
