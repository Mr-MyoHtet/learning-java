<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mybatis.mapper.StudentMapper">

<select id="getAllStudent" resultType="com.mybatis.model.Student">
SELECT * FROM student;
</select>

<select id="findStudentById" parameterType="int" resultType="com.mybatis.model.Student">
SELECT * FROM student where stud_id=#{id}
</select>

<insert id="insertStudent" parameterType="com.mybatis.model.Student" useGeneratedKeys="true" keyProperty="stud_id">
   INSERT INTO student (stud_id, name, email, phone, dob, bio)
   VALUES(#{stud_id}, #{name}, #{email}, #{phone}, #{dob}, #{bio})
</insert>

</mapper>
